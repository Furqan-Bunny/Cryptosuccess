# Supabase Configuration
# Project URL + anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Crypto payments (NOWPayments) — OPTIONAL. When unset, /api/crypto/checkout
# returns 503 and the "Pay with crypto" button surfaces "not enabled". Invoices are
# one-time: paying grants Pro for a fixed period (monthly/yearly), no auto-renew.
# Get the API key (Settings → API keys) + IPN secret (Settings → IPN) from the
# NOWPayments dashboard, and set the IPN callback to <app>/api/crypto/webhook.
# Needs migration 0006 for idempotency. NEXT_PUBLIC_APP_URL must be a public URL so
# NOWPayments can reach the webhook (use a tunnel like ngrok for local testing).
# For sandbox testing set NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# Anthropic API (Server-side - powers the AI analyst layer + daily brief)
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Secret for ALL scheduled/cron routes (Vercel Cron or an external scheduler
# sends it as `Authorization: Bearer <CRON_SECRET>`). Guards:
#   /api/brief/generate   (daily)  – AI market brief
#   /api/engine/tick      (~1 min) – fills stop-loss/take-profit/trailing/limit
#                                    orders and liquidates futures positions
#   /api/dca/run          (daily)  – executes recurring DCA buys
#   /api/staking/refresh  (daily)  – caches staking APYs from DefiLlama
#   /api/discover/scan    (daily)  – detects newly-listed coins
# IMPORTANT: /api/engine/tick must run frequently (~every minute) for auto
# stop-loss to feel responsive. Vercel Hobby crons run only once/day — use
# Vercel Pro (the "* * * * *" schedule in vercel.json), OR an external
# scheduler (cron-job.org, Upstash QStash, GitHub Actions) POSTing the engine
# tick every 1–2 min with this same Bearer token.
CRON_SECRET=your_random_cron_secret

# Supabase service-role key (Server-side ONLY — bypasses Row-Level Security).
# Used by the engine, cron routes and the Stripe webhook. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Telegram bot (the product surface) ───────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram → copy the token here.
# 2. Generate a random secret (e.g. `openssl rand -hex 32`) for TELEGRAM_WEBHOOK_SECRET —
#    Telegram echoes it in the x-telegram-bot-api-secret-token header and the
#    webhook route (/api/telegram/webhook) rejects requests that don't match.
# 3. Deploy to a public URL (or tunnel localhost with ngrok), set NEXT_PUBLIC_APP_URL,
#    then run: npx tsx scripts/set-telegram-webhook.ts
# Requires migration 0007 (telegram_users + consume_telegram_signal). Both are
# server-side secrets — NEVER prefix with NEXT_PUBLIC_ or commit real values.
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret
# Optional, public: the bot's @username (without @) — shown on Settings → Telegram
# as a deep link next to the one-time /link code.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=cryptosuccess_coach_bot

# API Keys (Server-side only)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
COINGECKO_API_KEY=your_coingecko_api_key

# Stripe Price IDs (from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_price_id
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Verifiable track record (on-chain anchoring) ─────────────────────────────
# ALL optional. When these are unset the anchoring cron still computes + stores
# daily Merkle roots off-chain (status 'pending'); it only submits on-chain once
# configured. Start on a TESTNET (e.g. Base Sepolia) — the signer needs only a
# little test gas and the contract holds no funds.
#
# Server-side (never exposed): the anchoring signer + target chain.
#   ANCHOR_SIGNER_KEY  – 0x-prefixed private key of a dedicated low-value hot
#                        wallet that owns the TrackRecordAnchor contract.
ANCHOR_RPC_URL=https://sepolia.base.org
ANCHOR_SIGNER_KEY=0xyour_anchor_signer_private_key
ANCHOR_CONTRACT_ADDRESS=0xdeployed_TrackRecordAnchor_address
ANCHOR_CHAIN_ID=84532
ANCHOR_NETWORK=base-sepolia
#
# Public (browser verifier reads the chain directly — trustless verification):
NEXT_PUBLIC_ANCHOR_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ANCHOR_CHAIN_ID=84532
NEXT_PUBLIC_ANCHOR_CONTRACT_ADDRESS=0xdeployed_TrackRecordAnchor_address
NEXT_PUBLIC_ANCHOR_NETWORK=base-sepolia
NEXT_PUBLIC_ANCHOR_EXPLORER_URL=https://sepolia.basescan.org

# ── Live on-chain trading (non-custodial, OPT-IN) ────────────────────────────
# OFF by default. Real trade execution can require licensing/KYC/geo limits —
# get a legal review before enabling on a mainnet. Non-custodial: users sign in
# their own wallet; the app never holds keys or funds.
#   Enable: set NEXT_PUBLIC_LIVE_TRADING_ENABLED=true AND a WalletConnect id.
#   Default chain is a TESTNET (Base Sepolia, 84532). 0x live swaps need a 0x-
#   supported chain (e.g. Base mainnet 8453) + ZEROX_API_KEY.
NEXT_PUBLIC_LIVE_TRADING_ENABLED=false
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_LIVE_TRADING_CHAIN_ID=84532
NEXT_PUBLIC_LIVE_TRADING_RPC_URL=
# Server-side (0x Swap API key kept off the client):
ZEROX_API_KEY=your_0x_api_key
ZEROX_API_URL=https://api.0x.org

# Note: Fear & Greed Index (api.alternative.me) and Binance Funding Rates are free APIs - no keys needed

# ── Stripe Pro prices (server-side) ──────────────────────────────────────────
# The checkout route picks the price from {plan, interval} on the SERVER — the
# browser never sends a price id. Create two recurring prices for the Pro
# product (monthly + yearly) in the Stripe Dashboard and paste their ids here.
# If STRIPE_PRO_MONTHLY_PRICE_ID is unset, NEXT_PUBLIC_STRIPE_PRO_PRICE_ID is used
# for monthly (backwards compatible). Yearly checkout is refused (503) until
# STRIPE_PRO_YEARLY_PRICE_ID is set.
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_price_id
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly_price_id
# Crypto Pro expiry: schedule /api/subscriptions/expire (daily or hourly) with the
# same CRON_SECRET bearer token. Requires migration 0009.

# ── Monitoring, alerting & ops ───────────────────────────────────────────────
# Server errors are reported by src/lib/server/report-error.ts as one-line JSON
# logs (Vercel logs / log drains) and stored in the `error_events` table; every
# cron run is recorded in `cron_runs` (both need migration 0011). Operators can
# read GET /api/ops/status with the CRON_SECRET Bearer token — add ?strict=1 to
# get HTTP 503 when any scheduled job is stale or failing (the GitHub
# "Scheduler" workflow checks this hourly). GET /api/health is a public, minimal
# liveness probe for uptime monitors.
#
# Optional admin alerts: when set (together with TELEGRAM_BOT_TOKEN above),
# errors are also sent to this Telegram chat, at most one message per error
# context every 10 minutes. Use a numeric chat id (DM the bot, then read the id
# from getUpdates, or a negative id for a group) or a public @channel the bot
# can post in. Leave empty to disable alerts.
ALERT_TELEGRAM_CHAT_ID=

# ── Rate limiting (Upstash Redis REST) ───────────────────────────────────────
# Optional. Backs the fixed-window limiter in src/lib/server/rate-limit.ts (AI
# analyst, market data proxies, track-record proofs). When unset — or on Redis errors —
# limits are NOT enforced (fails open), so set both in production. Create a
# Redis database at upstash.com and copy the REST URL + token. Server-side only.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional override for the CoinGecko API base URL used by market.service.ts on
# the server (defaults to the public API).
COINGECKO_API_URL=https://api.coingecko.com/api/v3
#
# GitHub repository secrets (not env vars — set under Settings → Secrets →
# Actions) used by .github/workflows/scheduler.yml:
#   APP_URL      https URL of the deployment, e.g. https://your-app.vercel.app
#   CRON_SECRET  same value as CRON_SECRET above
# The scheduler fails (red run + email) when either is missing.
