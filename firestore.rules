rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isProUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.status == 'pro';
    }

    // User document rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        // Allow all updates EXCEPT direct subscription status/planId/customerId changes
        // Users CAN update signalsUsedToday and lastResetDate (for daily limit tracking)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']) ||
         request.resource.data.subscription.diff(resource.data.subscription).affectedKeys()
           .hasOnly(['signalsUsedToday', 'lastResetDate']));
    }

    // User preferences
    match /users/{userId}/preferences/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Trading history - top-level collection (used by portfolio.service.ts)
    match /trades/{tradeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Trading history - subcollection (legacy, pro users only)
    match /users/{userId}/trades/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isProUser();
    }

    // Orders collection (used by trade-execution.service.ts)
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Signals collection (for signal history tracking)
    match /signals/{signalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Owner may only update outcome-evaluation fields on their own signals.
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['outcome', 'profitLossPercent', 'priceAt24h', 'evaluatedAt']);
      // No delete.
    }

    // Subscription logs (created by stripe.service.ts)
    match /subscription_logs/{logId} {
      allow read: if false; // Admin only
      allow create: if isSignedIn();
    }

    // Public market data (read-only)
    match /marketData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // AI training data (admin only)
    match /aiTrainingData/{document=**} {
      allow read, write: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Daily Market Brief (written server-side via Admin SDK, read by signed-in users)
    match /briefs/{briefId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Simulated cash account (powers paper futures + staking)
    match /paper_accounts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Paper futures positions. Owner manages their own; liquidation is written
    // server-side via the Admin SDK (which bypasses these rules).
    match /futures_positions/{positionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Simulated staking positions
    match /staking_positions/{positionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // DCA / recurring-buy schedules
    match /dca_schedules/{scheduleId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Cached staking APYs (written server-side via Admin SDK)
    match /staking_rates/{symbol} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Newly-detected coin listings (written server-side via Admin SDK)
    match /new_listings/{listingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Discovery bookkeeping (known-symbol snapshot) — server-only
    match /discovery_state/{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
