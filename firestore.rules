rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isProUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.status == 'pro';
    }

    // User document rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        // Allow all updates EXCEPT direct subscription status/planId/customerId changes
        // Users CAN update signalsUsedToday and lastResetDate (for daily limit tracking)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']) ||
         request.resource.data.subscription.diff(resource.data.subscription).affectedKeys()
           .hasOnly(['signalsUsedToday', 'lastResetDate']));
    }

    // User preferences
    match /users/{userId}/preferences/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Trading history - top-level collection (used by portfolio.service.ts)
    match /trades/{tradeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Trading history - subcollection (legacy, pro users only)
    match /users/{userId}/trades/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isProUser();
    }

    // Orders collection (used by trade-execution.service.ts)
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Signals collection (for signal history tracking)
    match /signals/{signalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow write: if false; // Only backend/admin can modify after creation
    }

    // Subscription logs (created by stripe.service.ts)
    match /subscription_logs/{logId} {
      allow read: if false; // Admin only
      allow create: if isSignedIn();
    }

    // Public market data (read-only)
    match /marketData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // AI training data (admin only)
    match /aiTrainingData/{document=**} {
      allow read, write: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
