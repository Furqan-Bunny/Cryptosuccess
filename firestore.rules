rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isProUser() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.status == 'pro';
    }

    // User document rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        // Prevent users from directly modifying subscription status
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']));
    }

    // User preferences
    match /users/{userId}/preferences/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Trading history (pro users only)
    match /users/{userId}/trades/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isProUser();
    }

    // Public market data (read-only)
    match /marketData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // AI training data (admin only)
    match /aiTrainingData/{document=**} {
      allow read, write: if false;
    }
  }
}